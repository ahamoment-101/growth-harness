# Local configuration. Copy to .dev.vars or run npm run setup. Never commit the filled file.
# Required/optional details and application links: docs/configuration.md

# Login: password (default), google, or password,google.
AUTH_LOGIN_METHODS=password
# Generated by npm run setup. Required only to create the first administrator.
AUTH_SETUP_TOKEN=
# Required for Google login and GSC state signing; generated by setup.
AUTH_SESSION_SECRET=
# Required together only when google is explicitly enabled.
AUTH_ALLOWED_GOOGLE_EMAIL=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Models: keys are required only for providers referenced by MODEL_REGISTRY.
# Defaults and per-Agent reasoning: shared/config/agent-models.json. Only OPENROUTER_API_KEY is needed.
# MODEL_REGISTRY is an optional full override (Wrangler for deployment, here for local only).
# Production secret uploads use the bundled defaults or the Wrangler override, never the local override.

# Optional web research. Research tools need this key.
FIRECRAWL_API_KEY=
FIRECRAWL_RESEARCH_MODEL=spark-2
FIRECRAWL_RESEARCH_MAX_CREDITS=100

# Optional paid Keyword Research Agent metrics / SERP. Both API credentials are needed.
# Leave empty to keep existing research methods without measured DataForSEO metrics.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional Search Console (separate from application Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes as 64 hex characters. Never rotate without migrating stored tokens.
GSC_TOKEN_CIPHER_KEY=

# Optional custom-domain diagnostics; the token is NOT needed for ordinary Wrangler CLI login.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Must match wrangler.jsonc name when custom-domain diagnostics are used.
CLOUDFLARE_WORKER_NAME=growth-harness
CNAME_TARGET=
# Optional IndexNow.
INDEXNOW_KEY=

# Only the selected connections need credentials. Keep all values private.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
