# Local configuration. Copy to .dev.vars or run npm run setup. Never commit the filled file.
# Required/optional details and application links: docs/configuration.md

# Login: password (default), google, or password,google.
AUTH_LOGIN_METHODS=password
# Generated by npm run setup. Required only to create the first administrator.
AUTH_SETUP_TOKEN=
# Required for Google login and GSC state signing; generated by setup.
AUTH_SESSION_SECRET=
# Required together only when google is explicitly enabled.
AUTH_ALLOWED_GOOGLE_EMAIL=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Models: keys are required only for providers referenced by MODEL_REGISTRY.
# This sample uses OpenRouter for every Agent. agentProfiles can override individual Agents.
MODEL_REGISTRY={"version":2,"defaultProfile":"openrouter/default","agentProfiles":{},"connections":{"openrouter":{"protocol":"openai-chat","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","headers":{"HTTP-Referer":"https://github.com/ahamoment-101/growth-harness","X-OpenRouter-Title":"GrowthHarness"}},"openai":{"protocol":"openai-responses","baseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY"},"anthropic":{"protocol":"anthropic-messages","baseUrl":"https://api.anthropic.com/v1","apiKeyEnv":"ANTHROPIC_API_KEY"}},"profiles":{"openrouter/default":{"supportedParameters":["tools","tool_choice","max_tokens","response_format","reasoning","reasoning_effort"],"reasoningSupported":true,"reasoningRequired":false,"connection":"openrouter","model":"openai/gpt-5.6-terra","contextWindow":1050000,"maxOutputTokens":128000,"sourceUrl":"https://openrouter.ai/api/v1/models","compatibility":{"thinkingFormat":"openrouter","supportsReasoningEffort":true}},"openai/default":{"supportedParameters":["tools","tool_choice","max_output_tokens","text.format","reasoning"],"reasoningSupported":true,"reasoningRequired":false,"connection":"openai","model":"gpt-5.6-terra","contextWindow":1050000,"maxOutputTokens":128000,"sourceUrl":"https://developers.openai.com/api/docs/models/gpt-5.6-terra"},"anthropic/default":{"supportedParameters":["tools","tool_choice","max_tokens","response_format"],"reasoningSupported":true,"reasoningRequired":false,"connection":"anthropic","model":"claude-sonnet-5-5","contextWindow":1000000,"maxOutputTokens":128000,"sourceUrl":"https://platform.claude.com/docs/en/models/overview","compatibility":{"forceAdaptiveThinking":true}}}}

# Optional web research. Research tools need this key.
FIRECRAWL_API_KEY=
FIRECRAWL_RESEARCH_MODEL=spark-2
FIRECRAWL_RESEARCH_MAX_CREDITS=100

# Optional keyword metrics / SERP. Both are needed for DataForSEO operations.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional Search Console (separate from application Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes as 64 hex characters. Never rotate without migrating stored tokens.
GSC_TOKEN_CIPHER_KEY=

# Optional custom-domain diagnostics; the token is NOT needed for ordinary Wrangler CLI login.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Must match wrangler.jsonc name when custom-domain diagnostics are used.
CLOUDFLARE_WORKER_NAME=programmatic-seo
CNAME_TARGET=
# Optional IndexNow.
INDEXNOW_KEY=

# Only the selected connections need credentials. Keep all values private.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local synthetic fixture endpoints only. Keep false in deployed installations.
DEV_TOOLS_ENABLED=false
