{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-harness",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  // Optional invocation limits must match your Cloudflare plan and the Runtime execution handoff policy.
  // Review current platform limits before configuring limits.subrequests.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Deployment identity: the site room drops read models built by an older deploy.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growth-harness",
      // Local-only placeholder: Miniflare requires a non-empty ID. Replace with your D1 ID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RESEARCH_BUCKET", "bucket_name": "growth-harness-research" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_SHELL",
        "class_name": "AgentShell"
      },
      {
        "name": "SITE_ROOM",
        "class_name": "SiteRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-agent-runtime-probe",
      "new_sqlite_classes": ["AgentRuntimeProbe"]
    },
    {
      "tag": "v2-agent-shell",
      "new_sqlite_classes": ["AgentShell"]
    },
    {
      "tag": "v3-site-room",
      "new_sqlite_classes": ["SiteRoom"]
    },
    {
      // Keep prior migrations intact; deployment retires only the obsolete probe's stored state.
      "tag": "v4-retire-agent-runtime-probe",
      "deleted_classes": ["AgentRuntimeProbe"]
    }
  ],
  "workflows": [
    {
      "name": "publish-article",
      "binding": "PUBLISH_WORKFLOW",
      "class_name": "PublishWorkflow"
    },
    {
      "name": "localize-article",
      "binding": "LOCALIZE_WORKFLOW",
      "class_name": "LocalizeWorkflow"
    },
    {
      "name": "agent-runtime",
      "binding": "AGENT_WORKFLOW",
      "class_name": "AgentRuntimeWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *", "* * * * *"]
  },
  "vars": {
    // Model defaults: shared/config/agent-models.json. MODEL_REGISTRY is an optional full override.
    "CLOUDFLARE_WORKER_NAME": "growth-harness",
    "AGENT_RUNTIME_ENABLED": "true",
    "AUTH_LOGIN_METHODS": "password",
    "AUTH_ALLOWED_GOOGLE_EMAIL": "",
    "AUTH_GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "DATAFORSEO_LOGIN": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "CNAME_TARGET": ""
  }
}
