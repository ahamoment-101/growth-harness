{
  "name": "growth-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/collect-license-notices.mjs && node scripts/sanitize-build.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run config:check:deploy && npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "node scripts/d1-migrate.ts --local",
    "db:migrate:remote": "node scripts/d1-migrate.ts --remote",
    "test": "vitest run",
    "test:runtime": "vitest run worker/agent-runtime",
    "verify:runtime:local": "node scripts/verify-strategy-workflow-local.mjs",
    "verify:strategy:browser:local": "node scripts/verify-strategy-browser-local.mjs",
    "verify:runtime:long:local": "VERIFY_LONG_RUNTIME=1 node scripts/verify-strategy-workflow-local.mjs",
    "verify:business:workflow:local": "node scripts/verify-business-workflow-local.mjs",
    "setup": "node scripts/setup.ts",
    "config:check": "node scripts/config-check.ts",
    "config:check:deploy": "node scripts/deploy-check.ts",
    "secrets:upload": "node scripts/secrets-upload.ts",
    "auth:reset": "node scripts/auth-reset.ts",
    "verify:self-hosting:local": "node scripts/verify-self-hosting-local.mjs",
    "verify:model-configuration:local": "node scripts/verify-model-configuration-local.mjs",
    "core:sync": "node scripts/sync-public-core.mjs",
    "test:sync": "node --test scripts/sync-public-core.test.mjs",
    "release:check": "node scripts/check-public-boundary.mjs --export && node scripts/check-public-boundary.mjs --export --history && node scripts/check-public-boundary.mjs --export --artifacts dist"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.21.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "three": "^0.180.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahamoment-101/growth-harness.git"
  },
  "bugs": {
    "url": "https://github.com/ahamoment-101/growth-harness/issues"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/client": "$@modelcontextprotocol/client",
      "@modelcontextprotocol/server": "$@modelcontextprotocol/server",
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    }
  }
}
